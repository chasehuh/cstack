new file mode 100644
index 0000000..0e5d337
--- /dev/null
+++ b/src/cli/syncfile.ts
@@ -0,0 +1,45 @@
+import { liveFileMirrorEnabled, liveMirrorFile } from "../lib/paths.ts";
+import { syncLiveMirror } from "../lib/livemirror.ts";
+import type { MirrorSide } from "../lib/credstore.ts";
+import { c, fmtExpiry } from "./render.ts";
+
+export function describeSide(side: MirrorSide, now = Date.now()): string {
+  if (side.state === "valid" && side.expiresAt != null) return `access valid, expires ${fmtExpiry(side.expiresAt, now)}`;
+  if (side.state === "expired") return side.expiresAt == null ? "expiresAt missing (treated as expired)" : "access expired";
+  return side.state;
+}
+
+export async function cmdSyncFile(): Promise<number> {
+  if (process.platform !== "darwin" || !liveFileMirrorEnabled()) {
+    console.error(c.yellow("the live file mirror is off - it applies on macOS when ~/.config/tokenmaxxing/live-file-mirror exists or TOKENMAXXING_LIVE_FILE_MIRROR=1"));
+    return 1;
+  }
+  const out = await syncLiveMirror();
+  if (out == null || out.read == null) {
+    console.error(c.red("could not take claude's credential-refresh lock (a refresh is mid-flight) - retry shortly"));
+    return 1;
+  }
+  const file = liveMirrorFile();
+  const { keychain, file: f, current } = out.read;
+  switch (out.action) {
+    case "keychain-unavailable":
+      console.log(c.yellow(`login keychain not readable from this session (SSH): ${file} is the live store here (${describeSide(f)}); the GUI check timer copies it to the keychain`));
+      return f.raw == null ? 1 : 0;
+    case "no-credential":
+      console.error(c.red(`no live credential in the keychain or ${file}`));
+      return 1;
+    case "keychain->file":
+      console.log(`${c.green("↻")} copied the live credential keychain -> ${file} (${describeSide(current ?? f)})`);
+      return 0;
+    case "file->keychain":
+      console.log(`${c.green("↻")} copied the live credential ${file} -> keychain (${describeSide(current ?? keychain)})`);
+      return 0;
+    case "none":
+      if (keychain.hash != null && keychain.hash === f.hash) {
+        console.log(`${c.green("✓")} keychain and ${file} hold the same live credential (${describeSide(keychain)})`);
+        return 0;
+      }
+      console.log(c.yellow(`keychain (${describeSide(keychain)}) and ${file} (${describeSide(f)}) differ and neither is usable - run \`tokenmaxxing switch\``));
+      return 1;
+  }
+}
