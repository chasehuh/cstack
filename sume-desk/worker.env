# Load caps every desk worker inherits (sume#12962). agent-human-stream
# sources this before it starts the backend, so the backend's tool shells
# (and every test gate they run) see it. A value the caller already set wins.
#
# 18-core M5 worker Mac: 4 vitest workers per package x 4 packages at a time
# x up to 4 admitted gates (cstack-gate) keeps the box near 95% busy without
# a runnable queue. MQ CI uses 3 workers per package on 8 vCPU shards.
export VITEST_MAX_WORKERS="${VITEST_MAX_WORKERS:-4}"
export npm_config_workspace_concurrency="${npm_config_workspace_concurrency:-4}"
